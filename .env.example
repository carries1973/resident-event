# === AI API Keys ===
# Dev mode: VITE_ prefixed keys are used directly from the browser
VITE_ANTHROPIC_API_KEY=     # Claude API key (dev mode)

# Production mode: Non-VITE_ keys are used server-side in Vercel serverless functions
# Set these in Vercel dashboard → Project → Settings → Environment Variables
# ANTHROPIC_API_KEY=         # Claude API key (production — set in Vercel)

# === Unsplash API ===
# Free account: https://unsplash.com/developers → create app → copy Access Key
# Required for Promo Kit "Get Image" feature
# Also set in Vercel dashboard for production
VITE_UNSPLASH_ACCESS_KEY=   # Unsplash Access Key

# === Ticketmaster Discovery API ===
# Free account: https://developer-acct.ticketmaster.com/user/register → create app → copy Consumer Key
# Required for "Local Community Events" card in the Building form (Nearby Venues section)
# Free tier: 5,000 requests/day, no credit card required
# Also set in Vercel dashboard for production
VITE_TICKETMASTER_API_KEY=  # Ticketmaster Consumer Key

# Address autocomplete uses OpenStreetMap Nominatim — no API key required.

# === App Config ===
VITE_APP_NAME="Resident Event Planner"
VITE_APP_VERSION="1.0.0"
